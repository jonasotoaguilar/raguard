# Copy to .env and fill in real values. .env is gitignored; never commit real credentials.
# docker compose reads this file automatically for variable substitution.

# PostgreSQL + pgvector (infra/compose.yaml)
POSTGRES_USER=raguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=raguard

# Redis (infra/compose.yaml) — compose-local network; password required
REDIS_PASSWORD=change-me

# MinIO local object storage (infra/compose.yaml) — development only, never production
MINIO_ROOT_USER=raguard
MINIO_ROOT_PASSWORD=change-me
# S3-compatible client settings consumed by the API/worker (boto3 endpoint_url;
# pydantic settings read OBJECT_STORE_*). Locally the access key/secret are the
# MinIO root credentials above; in production point these at the real provider.
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_BUCKET=raguard-documents
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=raguard
OBJECT_STORE_SECRET_KEY=change-me

# Worker runtime (apps/worker, compose `worker` service). The compose service
# wires its own service-network URLs (postgres/redis/minio hostnames); these
# host-side values are for local runs, migrations, and one-off harnesses.
# All values are non-secret local placeholders; real deployments must supply
# their own credentials via the same variable names.
DATABASE_URL=postgresql+psycopg://raguard:change-me@127.0.0.1:5432/raguard
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# Worker pipeline bounds and alert thresholds (WorkerSettings, task 4.3/5.2).
# Timeline invariant: dispatch_wait < dispatch_freshness < sweep_age, and the
# pending-age alert threshold must sit beyond the sweep window.
DISPATCH_FRESHNESS_SECONDS=30
DISPATCH_WAIT_SECONDS=5
DISPATCH_POLL_INTERVAL_SECONDS=0.1
SWEEP_AGE_SECONDS=300
PENDING_AGE_SECONDS=900
PROVIDER_ATTEMPTS=3
MAX_RETRY_AFTER_SECONDS=5
MAX_PDF_PAGES=500
MAX_TEXT_CHARACTERS=5000000
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
MAX_CHUNKS=10000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
PROVIDER_TIMEOUT_SECONDS=30
SWEEP_BATCH_SIZE=100

# API/worker secrets — replace JWT_SECRET with a long random value (>=32 chars);
# unset or short secrets fail fast on startup. The placeholder below is a
# non-secret value long enough for local settings to start; it is NOT safe for
# production and MUST be replaced.
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-characters

# JWT auth (apps/api, PR 2)
JWT_ISSUER=raguard
JWT_AUDIENCE=raguard-api
JWT_EXPIRY_MINUTES=15
SESSION_COOKIE_NAME=raguard_session
SESSION_COOKIE_PATH=/api
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# JSON list; local Vite dev server only. Production must list the real origin(s).
ALLOWED_ORIGINS=["http://localhost:5173"]

# First-tenant bootstrap (apps/api, PR 4) — `apps/api/raguard-bootstrap` creates
# the first tenant, default roles, and admin atomically; re-runs are no-ops.
# Replace both placeholders before first use; never commit real secrets.
BOOTSTRAP_TENANT_NAME=Example Org
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-password

# Provider credentials (adapter-based; see ADR-0005). Keep empty until configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
